# AI provider configuration — copy this file to .env and fill in your values.
# Any OpenAI-compatible endpoint works (OpenRouter, OpenAI, Groq, Together, Fireworks, …).
# Switching provider = change these three vars. No code changes needed.
#
# .env is loaded automatically at server startup (Node 20.12+).
# If .env doesn't exist the server runs fine — AI mode returns 503 and the
# client falls back to the scripted dialogue.

# Your provider's API key. Required for AI mode.
AI_API_KEY=

# Base URL of an OpenAI-compatible /chat/completions endpoint.
# Default: OpenRouter (one key, hundreds of models)
AI_BASE_URL=https://openrouter.ai/api/v1

# Model slug understood by the provider above.
# OpenRouter examples: anthropic/claude-3.5-haiku  openai/gpt-4o-mini  google/gemini-flash-1.5
# Default: anthropic/claude-3.5-haiku
AI_MODEL=anthropic/claude-3.5-haiku
